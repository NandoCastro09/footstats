# Porta HTTP (o Render define automaticamente em produção)
PORT=3000

# Origens liberadas no CORS, separadas por vírgula.
# Aceita curinga: https://footstats-*.vercel.app (previews da Vercel)
CORS_ORIGIN=http://localhost:5173

# Fonte dos dados de futebol:
#   auto          → football-data.org se FOOTBALL_DATA_TOKEN estiver definido, senão mock (padrão)
#   football-data → sempre a football-data.org (exige o token)
#   mock          → sempre os dados fictícios
DATA_SOURCE=auto

# Chave gratuita da football-data.org (https://www.football-data.org/client/register).
# NUNCA commite a chave: este arquivo de exemplo vai para o Git; o .env não.
FOOTBALL_DATA_TOKEN=

# Opcional: chave gratuita da API-Football (https://dashboard.api-football.com).
# Traz fotos dos jogadores, número da camisa, elenco atual e técnico com foto.
# Sem ela, a página do time usa o elenco da football-data.org (sem fotos).
API_FOOTBALL_KEY=

# development | production | test
NODE_ENV=development
